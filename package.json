{
  "name": "sayso-app",
  "version": "1.0.0",
  "description": "Electron React Boilerplate App",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development concurrently \"vite\" \"electron electron/main.cjs\"",
    "build": "vite build --mode production",
    "clean": "rm -rf dist/ release/ node_modules/.cache electron/native-audio/build .vite",
    "clean-all": "npm run clean && rm -rf node_modules/ package-lock.json",
    "rebuild-native": "cd electron/native-audio && npx node-gyp rebuild --target=36.9.1 --arch=arm64 --dist-url=https://electronjs.org/headers && cd ../..",
    "rebuild-native-x64": "cd electron/native-audio && npx node-gyp rebuild --target=36.9.1 --arch=x64 --dist-url=https://electronjs.org/headers && cd ../..",
    "rebuild-native-both": "node scripts/rebuild-native-both-archs.js",
    "package": "npm run rebuild-native-both && npm run build && electron-builder",
    "export": "chmod +x rebuild-and-package.sh && ./rebuild-and-package.sh",
    "fresh-export": "npm run clean && npm run export",
    "test": "echo \"Error: no test specified\" && exit 1",
    "kill-port": "lsof -ti :5173 | xargs kill -9 || true",
    "rebuild-zoom": "cd electron/zoom-sdk && node-gyp rebuild",
    "install-zoom": "cd electron/zoom-sdk && npm install"
  },
  "keywords": [
    "electron",
    "react",
    "vite"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@electron/remote": "^2.0.7",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@runonatlas/react": "^2.8.0",
    "@supabase/supabase-js": "^2.49.4",
    "@tanstack/react-query": "^5.90.12",
    "@zoom/meetingsdk": "3.13.2",
    "axios": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "dotenv": "^16.5.0",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.1.8",
    "form-data": "^4.0.2",
    "google-protobuf": "^3.21.4",
    "lodash": "^4.17.21",
    "lucide-react": "^0.556.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-day-picker": "^9.12.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.68.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.5.3",
    "styled-components": "^6.1.18",
    "tailwind-merge": "^3.4.0",
    "uuid": "^11.1.0",
    "wav": "^1.0.2",
    "ws": "^8.18.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.91.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.22",
    "concurrently": "^8.2.2",
    "electron": "^36.4.0",
    "electron-builder": "^24.13.3",
    "electron-log": "^5.1.2",
    "postcss": "^8.5.6",
    "shadcn": "^3.5.1",
    "supabase": "^2.22.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^5.3.1"
  },
  "build": {
    "appId": "com.asksayso.app",
    "productName": "Sayso",
    "publish": {
      "provider": "github",
      "owner": "your-github-username",
      "repo": "your-repo-name"
    },
    "beforePack": "scripts/rebuild-native-for-arch.js",
    "afterPack": "scripts/verify-and-fix-native-module.js",
    "asar": false,
    "files": [
      "**/*",
      "!electron/full_recordings/**/*",
      "!electron/chunks/**/*"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "public/assets",
        "to": "assets"
      }
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "We need access to your microphone for audio calls",
        "NSAudioCaptureUsageDescription": "We need access to system audio to create multi-output devices for call recording"
      },
      "notarize": {
        "teamId": "Y57SJLCC9H"
      },
      "identity": "EXOMEND LLC (Y57SJLCC9H)"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
